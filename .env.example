PORT=5000
NODE_ENV=development

# Use the SAME database as the Next.js client (Better Auth stores users there)
MONGODB_URI=
MONGODB_DB=

# Comma separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# Better Auth JWKS endpoint exposed by the Next.js client (used to verify JWTs)
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks

STRIPE_SECRET_KEY=
# Optional: only if you register a webhook in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=

# Cron (node-cron). Set ENABLE_CRON=false on serverless hosts and call POST /api/cron/run instead
ENABLE_CRON=
CRON_SECRET=

# Optional SMTP for booking-completed emails (skipped if empty)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
